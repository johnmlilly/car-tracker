{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "car-tracker",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-11-01",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "car-tracker",
			"database_id": "b2e926fd-28a4-4b85-ad4d-364563ad3dc1",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "RECEIPTS",
			"bucket_name": "car-tracker-receipts"
		},
		{
			"bucket_name": "car-tracker-receipts",
			"binding": "car_tracker_receipts",
			"remote": true
		}
	],
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	}
}